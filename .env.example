# Kopiere diese Datei nach ".env" und trage nur ein, was du nutzen willst.
# Die Datei .env wird NICHT ins Git-Repository übernommen.

# Claude (Anthropic) – zusätzlich nötig: pip install anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# CUDI_ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI
# OPENAI_API_KEY=sk-...
# CUDI_OPENAI_MODEL=gpt-4o

# Lokales Modell über Ollama (https://ollama.com), danach: ollama pull llama3.1
# OLLAMA_HOST=http://localhost:11434
# CUDI_OLLAMA_MODEL=llama3.1

# Reihenfolge, in der Modelle versucht werden (Standard: lokal zuerst)
# CUDI_PROVIDER_ORDER=ollama,anthropic,openai

# Wie soll CUDI dich nennen?
# CUDI_USER_NAME=
